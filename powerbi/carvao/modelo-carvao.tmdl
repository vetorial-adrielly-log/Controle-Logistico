		measure '% Canceladas Carvão' = ```
				DIVIDE ( [Viagens Canceladas Carvão], [Viagens Planejadas Carvão] )
				```
			formatString: 0.00%
			lineageTag: 44e7d853-e75e-432a-b0fe-865d87f08f38

		measure 'Furos Carvão' = ```
				-- carga programada para um dia que já passou (até ontem) e que ficou sem status:
				-- não carregou (OK) nem foi cancelada (NOK)
				CALCULATE (
				    COUNTROWS ( f_basePlan ),
				    KEEPFILTERS ( ISBLANK ( f_basePlan[CARREGADO] ) || NOT ( f_basePlan[CARREGADO] IN { "OK", "NOK" } ) ),
				    KEEPFILTERS ( f_basePlan[DATA] < TODAY () )
				)
				```
			formatString: #,0
			lineageTag: 129bea58-5dff-44ac-a62e-9526e85d087b

		measure 'Viagens a Realizar Carvão' = ```
				-- programadas para hoje em diante, ainda sem status
				[Viagens Planejadas Carvão]
				    - COALESCE ( [Viagens Realizadas Carvão], 0 )
				    - COALESCE ( [Viagens Canceladas Carvão], 0 )
				    - COALESCE ( [Furos Carvão], 0 )
				```
			formatString: #,0
			lineageTag: 945a2d36-9407-4b08-98cc-1dec1627b4c6

		measure '% Furo Carvão' = ```
				DIVIDE ( [Furos Carvão], [Viagens Planejadas Carvão] )
				```
			formatString: 0.00%
			lineageTag: beff9ae0-c600-4b4c-9310-f99866d28e6b

