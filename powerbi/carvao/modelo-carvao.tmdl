		measure 'Gap Carvão (m³)' = ```
				[Carregado Carvão (m³)] - [Meta Carvão (m³)]
				```
			formatString: #,0
			lineageTag: 239f52e5-92da-4057-8551-7110d50bd483

		measure 'Média Diária Carvão' = ```
				DIVIDE ( [Carregado Carvão (m³)], [Dias com Carregamento], 0 )
				```
			formatString: #,0
			lineageTag: 3a242a8e-810f-49e4-9cb9-c026558920ab

		measure 'Média Necessária Carvão' = ```
				-- quanto precisa carregar por dia, a partir de amanhã, para fechar a meta do mês (base D-1)
				VAR _base =
				    COALESCE (
				        CALCULATE ( MIN ( f_basePlan[DATA] ), KEEPFILTERS ( f_basePlan[CARREGADO] = "OK" ), ALLSELECTED ( f_basePlan[DATA] ), ALLSELECTED ( d_Calendario ) ),
				        MIN ( d_Calendario[Date] )
				    )
				VAR _fim  = EOMONTH ( _base, 0 )
				VAR _ref  = MIN ( TODAY () - 1, _fim )
				VAR _rest = DATEDIFF ( _ref, _fim, DAY )
				VAR _real = CALCULATE ( [Carregado Carvão (m³)], ALLSELECTED ( f_basePlan[DATA] ), ALLSELECTED ( d_Calendario ) )
				VAR _meta = CALCULATE ( [Meta Carvão (m³)], ALLSELECTED ( f_basePlan[DATA] ), ALLSELECTED ( d_Calendario ) )
				VAR _gap  = _meta - COALESCE ( _real, 0 )
				RETURN
				    SWITCH (
				        TRUE (),
				        ISBLANK ( _meta ), BLANK (),
				        _gap <= 0, 0,
				        _rest <= 0, BLANK (),
				        DIVIDE ( _gap, _rest )
				    )
				```
			formatString: #,0
			lineageTag: 30090a28-8862-4f34-bb48-3e5dab747cfd

		measure 'Lacuna Carvão' = ```
				-- dispersão: média realizada - média necessária. Vazia quando não há média necessária
				-- (mês já fechado ou sem meta); antes repetia a média realizada nesses casos
				VAR _nec = [Média Necessária Carvão]
				RETURN
				    IF ( NOT ISBLANK ( _nec ), [Média Diária Carvão] - _nec )
				```
			formatString: #,0
			lineageTag: 53de2a93-546a-4e53-b12c-20c1f3303c57

		measure 'Tendência Carvão (m³)' = ```
				-- projeção do mês: carregado + média diária x dias restantes (base D-1), limitada à meta.
				-- Calculada no nível do filtro atual: total na tela, por UPC/destino nas linhas da tabela.
				VAR _base =
				    COALESCE ( CALCULATE ( MIN ( f_basePlan[DATA] ), KEEPFILTERS ( f_basePlan[CARREGADO] = "OK" ) ), MIN ( d_Calendario[Date] ) )
				VAR _fim  = EOMONTH ( _base, 0 )
				VAR _ref  = MIN ( TODAY () - 1, _fim )
				VAR _real = [Carregado Carvão (m³)]
				VAR _dias = [Dias com Carregamento]
				VAR _meta = [Meta Carvão (m³)]
				VAR _rest = DATEDIFF ( _ref, _fim, DAY )
				VAR _proj = _real + DIVIDE ( _real, _dias ) * _rest
				RETURN
				    SWITCH (
				        TRUE (),
				        ISBLANK ( _meta ) || _meta <= 0, BLANK (),
				        ISBLANK ( _real ), 0,
				        _real >= _meta, _meta,
				        _rest <= 0, _real,
				        MIN ( _proj, _meta )
				    )
				```
			formatString: #,0
			lineageTag: b0c399a4-b9a6-4b7e-8826-1bb95a0af63f

		measure '% Ritmo Carvão' = ```
				DIVIDE ( [Tendência Carvão (m³)], [Meta Carvão (m³)], 0 )
				```
			formatString: 0.00%
			lineageTag: a04de388-2ebd-4a30-8eda-8edbf7db9468

		measure 'Previsão Carvão' = ```
				-- último dia carregado + dias que faltam no ritmo atual para fechar a meta
				VAR _med  = CALCULATE ( [Média Diária Carvão], ALLSELECTED ( f_basePlan[DATA] ), ALLSELECTED ( d_Calendario ) )
				VAR _gap  = CALCULATE ( [Gap Carvão (m³)], ALLSELECTED ( f_basePlan[DATA] ), ALLSELECTED ( d_Calendario ) )
				VAR _falta = IF ( _gap < 0, -_gap, 0 )
				VAR _last = CALCULATE ( MAX ( f_basePlan[DATA] ), KEEPFILTERS ( f_basePlan[CARREGADO] = "OK" ), ALLSELECTED ( f_basePlan[DATA] ), ALLSELECTED ( d_Calendario ) )
				RETURN
				    SWITCH (
				        TRUE (),
				        ISBLANK ( _last ), BLANK (),
				        _falta = 0, _last,
				        _med = 0, BLANK (),
				        _last + ROUNDUP ( DIVIDE ( _falta, _med ), 0 )
				    )
				```
			formatString: dd/mm/yyyy
			lineageTag: 01d509cf-86ff-406b-bb9e-787e13bf5c4e

		measure 'Dias de Chegada Carvão' = ```
				VAR _prev = [Previsão Carvão]
				RETURN
				    IF ( ISBLANK ( _prev ), BLANK (), MAX ( DATEDIFF ( TODAY (), _prev, DAY ), 0 ) )
				```
			formatString: 0
			lineageTag: 8f4ce4d2-629f-40e5-9eb3-1168441399a2

		measure 'Contagem de Dias Carvão' = ```
				VAR _base =
				    COALESCE (
				        CALCULATE ( MIN ( f_basePlan[DATA] ), KEEPFILTERS ( f_basePlan[CARREGADO] = "OK" ), ALLSELECTED ( f_basePlan[DATA] ), ALLSELECTED ( d_Calendario ) ),
				        CALCULATE ( MIN ( d_Calendario[Date] ), ALLSELECTED ( d_Calendario ) )
				    )
				VAR _ini = DATE ( YEAR ( _base ), MONTH ( _base ), 1 )
				VAR _fim = EOMONTH ( _base, 0 )
				-- Base é D-1: referência é o último dia fechado (ontem)
				VAR _ref = MIN ( TODAY () - 1, _fim )
				VAR DiasTotais     = DAY ( _fim )
				VAR DiasDecorridos = MAX ( DATEDIFF ( _ini, _ref, DAY ) + 1, 0 )
				VAR DiasRestantes  = DiasTotais - DiasDecorridos
				RETURN
				    IF (
				        ISBLANK ( _base ),
				        "Sem carregamento no período",
				        "Dias totais: " & DiasTotais & UNICHAR ( 10 ) &
				        "Dias decorridos: " & DiasDecorridos & UNICHAR ( 10 ) &
				        "Faltam: " & DiasRestantes & " dias"
				    )
				```
			lineageTag: 425557e5-632a-4eb1-9519-1da3fabf7152

		measure 'Média Realizada Carvão (Mês)' = ```
				-- linha "média realizada" dos gráficos: média diária do mês do ponto, até ontem
				VAR _d0  = MIN ( d_Calendario[Date] )
				VAR _d   = MAX ( d_Calendario[Date] )
				VAR _ini = DATE ( YEAR ( _d ), MONTH ( _d ), 1 )
				VAR _ref = MIN ( TODAY () - 1, EOMONTH ( _d, 0 ) )
				VAR _v =
				    CALCULATE (
				        [Média Diária Carvão],
				        REMOVEFILTERS ( d_Calendario ),
				        DATESBETWEEN ( d_Calendario[Date], _ini, _ref )
				    )
				RETURN
				    IF ( _d0 <= _ref, _v )
				```
			formatString: #,0
			lineageTag: 69df44ba-ccb5-4363-af68-49b49c54f536

		measure 'Média Necessária Carvão (Mês)' = ```
				-- linha "média necessária" dos gráficos: o que falta da meta do mês / dias que faltam
				VAR _d    = MIN ( d_Calendario[Date] )
				VAR _ini  = DATE ( YEAR ( _d ), MONTH ( _d ), 1 )
				VAR _fim  = EOMONTH ( _d, 0 )
				VAR _ref  = MIN ( TODAY () - 1, _fim )
				VAR _real =
				    CALCULATE (
				        [Carregado Carvão (m³)],
				        REMOVEFILTERS ( d_Calendario ),
				        DATESBETWEEN ( d_Calendario[Date], _ini, _ref )
				    )
				VAR _meta =
				    CALCULATE (
				        [Meta Carvão (m³)],
				        REMOVEFILTERS ( d_Calendario ),
				        DATESBETWEEN ( d_Calendario[Date], _ini, _fim )
				    )
				VAR _rest = DATEDIFF ( _ref, _fim, DAY )
				VAR _gap  = _meta - COALESCE ( _real, 0 )
				RETURN
				    SWITCH (
				        TRUE (),
				        ISBLANK ( _meta ), BLANK (),
				        _gap <= 0, 0,
				        _rest <= 0, BLANK (),
				        DIVIDE ( _gap, _rest )
				    )
				```
			formatString: #,0
			lineageTag: 5da17e8d-0f22-48c9-b3a3-0b161125a78b

		measure 'Estoque Carvão CMG' = ```
				VAR _u =
				    CALCULATE (
				        MAX ( f_Estoque_VS[DATA] ),
				        KEEPFILTERS (
				            FILTER (
				                f_Estoque_VS,
				                NOT ISBLANK ( f_Estoque_VS[ESTOQUE - VS CMG] ) || f_Estoque_VS[ESTOQUE - VS RRP - TOTAL] <> 0
				            )
				        )
				    )
				RETURN
				    CALCULATE ( SUM ( f_Estoque_VS[ESTOQUE - VS CMG] ), REMOVEFILTERS ( d_Calendario ), f_Estoque_VS[DATA] = _u )
				```
