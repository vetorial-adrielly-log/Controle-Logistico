			sourceColumn: DESTINO

		column 'Planejado m³'
			dataType: double
			formatString: #,0
			lineageTag: 3f47b681-6ef8-4154-a649-9faf269e1d6f
			summarizeBy: none
			sourceColumn: Planejado m³

		partition 'f_PlanPCPCarvao' = m
			mode: import
			source =
					// f_PlanPCPCarvao — planejamento diário de puxada de carvão enviado pelo PCP por e-mail.
					// O Power Automate grava cada e-mail "Planejamento de Expedição de Carvão - dd/mm" na tabela
					// tbPlanPCP do arquivo "Planejamento PCP Carvao.xlsx" (pasta Indicadores › Planejamento PCP).
					// Se o arquivo não for achado, o erro lista as pastas/arquivos que existem, para corrigir o nome.
					// Uma linha por dia x UPC x destino (RRP/CMG), em m³.
					let
					    // mesma ligação de nomes usada em d_UPC_Map (o PCP usa nomes curtos: "Lageado", "Móvel"...)
					    Mapa     = {
					                   {"OURO VERDE",      "UPC OURO VERDE"},
					                   {"MATA VERDE",      "UPC MATA VERDE"},
					                   {"VERDE MAR",       "UPC VERDE MAR"},
					                   {"LAJEADO",         "UPC LAGEADO"},
					                   {"LAGEADO",         "UPC LAGEADO"},
					                   {"NOVA DA MATA",    "UPC NOVA DA MATA"},
					                   {"CABECEIRA FUNDA", "UPC CABECEIRA FUNDA"},
					                   {"ÁGUA LIMPA",      "UPC ÁGUA LIMPA"},
					                   {"AGUA LIMPA",      "UPC ÁGUA LIMPA"},
					                   {"MÓVEL",           "UPC MÓVEL 1"},
					                   {"MOVEL",           "UPC MÓVEL 1"},
					                   {"BOM FUTURO",      "UPC BOM FUTURO"},
					                   {"LOBO",            "UPC LOBO"},
					                   {"SÃO JOÃO",        "UPC SÃO JOÃO"},
					                   {"MANGABA",         "UPC MANGABA"},
					                   {"AGROBUSINESS",    "UPC AGROBUSINESS"},
					                   {"DOURAFORTE",      "UPC DOURAFORTE"},
					                   {"FGMG",            "UPC FGMG"},
					                   {"GERDAU",          "UPC GERDAU"}
					               },
					    // procura o arquivo sem exigir o nome exato: ignora maiúsculas, acentos e espaços extras
					    // (pasta "Planejamento PCP" e arquivo "Planejamento PCP Carvao.xlsx" ou "...Carvão.xlsx")
					    Normal   = (t as text) as text =>
					                   List.Accumulate(
					                       {{"á","a"},{"à","a"},{"ã","a"},{"â","a"},{"é","e"},{"ê","e"},{"í","i"},
					                        {"ó","o"},{"ô","o"},{"õ","o"},{"ú","u"},{"ç","c"},{"  "," "}},
					                       Text.Lower(Text.Trim(t)),
					                       (acc, par) => Text.Replace(acc, par{0}, par{1})),
					    Indic    = fnPastaSP(
					                   pSiteLog,
					                   {"Shared Documents", "Campo Grande", "4. Carvão", "Programação de Expedição", "Indicadores"}
					               ),
					    PastaPCP = Table.SelectRows(Indic, each [Content] is table
					                                           and Text.Contains(Normal([Name]), "planejamento pcp")),
					    // se a pasta "Planejamento PCP" não aparecer, procura o arquivo em todas as subpastas de Indicadores
					    Subpastas = Table.SelectRows(Indic, each [Content] is table),
					    Arqs     = Table.Combine(
					                   List.Transform(
					                       {Indic} & (if Table.IsEmpty(PastaPCP) then Subpastas[Content] else PastaPCP[Content]),
					                       each Table.SelectRows(_, (r) => not (r[Content] is table)))),
					    Planilhas = Table.Sort(
					                   Table.SelectRows(Arqs, each [Extension] = ".xlsx"
					                                          and not Text.StartsWith([Name], "~$")
					                                          and Text.StartsWith(Normal([Name]), "planejamento pcp carv")),
					                   {{"Date modified", Order.Descending}}),
					    Arquivo  = if Table.IsEmpty(Planilhas) then
					                   error "Arquivo ""Planejamento PCP Carvao.xlsx"" não encontrado em Indicadores nem nas subpastas. "
					                         & "Subpastas: " & Text.Combine(Subpastas[Name], " | ")
					               else Planilhas{0}[Content],
					    Pasta    = Excel.Workbook(Arquivo, null, true),
					    Tabela   = Pasta{[Item = "tbPlanPCP", Kind = "Table"]}[Data],
					    Datas    = Table.TransformColumns(Tabela, {{"Data", each
					                   if _ is number then Date.From(_)                       // série do Excel
					                   else if _ is date or _ is datetime then Date.From(_)
					                   else Date.FromText(Text.Start(Text.From(_), 10), [Format = "yyyy-MM-dd"]), type date}}),
					    Tipado   = Table.TransformColumnTypes(Datas, {{"UPC", type text}, {"Destino", type text}, {"Planejado m3", type number}}),
					    Validas  = Table.SelectRows(Tipado, each [Data] <> null and [UPC] <> null and [#"Planejado m3"] <> null),
					    ComPart  = Table.AddColumn(Validas, "UPC Partição", each
					                   let
					                       u   = Text.Upper([UPC]),
					                       hit = List.First(List.Select(Mapa, (p) => Text.Contains(u, p{0})), null)
					                   in
					                       if hit <> null then hit{1}
					                       else Text.Trim(Text.Upper(Text.BeforeDelimiter([UPC], "("))),   // TERCEIRO, IMPORTADO...
					                   type text),
					    Final    = Table.RenameColumns(
					                   Table.SelectColumns(ComPart, {"Data", "UPC", "UPC Partição", "Destino", "Planejado m3"}),
					                   {{"UPC", "UPC (e-mail)"}, {"Destino", "DESTINO"}, {"Planejado m3", "Planejado m³"}})
					in
					    Final

	table 'd_UPC_Carvao'
		lineageTag: 0a8ee5df-e382-4b44-bac7-055f69ce67f4

		column 'UPC Partição'
			dataType: string
			lineageTag: c44213cb-4c4d-4e91-8b3e-1d63d56aaaf0
			summarizeBy: none
			sourceColumn: UPC Partição

		column 'Tipo'
			dataType: string
			lineageTag: ce64d5ee-00df-49ba-9d5b-f58e6ae15a88
			summarizeBy: none
			sourceColumn: Tipo

		partition 'd_UPC_Carvao' = m
			mode: import
			source =
					// d_UPC_Carvao — uma linha por UPC da partição (com o Tipo mais recente: Própria/Contrato),
					// mais as UPCs da base de puxada e do planejamento do PCP que não estão na partição.
					let
					    DaMeta = Table.Buffer(Table.Sort(
					                 Table.SelectColumns(f_MetaCarvao, {"UPC Partição", "Tipo", "Mês"}),
					                 {{"Mês", Order.Descending}})),
					    Unicas = Table.Distinct(Table.SelectColumns(DaMeta, {"UPC Partição", "Tipo"}), {"UPC Partição"}),
					    DoMapa = Table.SelectRows(
					                 Table.Distinct(Table.Combine({
					                     Table.SelectColumns(d_UPC_Map, {"UPC Partição"}),
					                     Table.SelectColumns(f_PlanPCPCarvao, {"UPC Partição"})})),
					                 each not List.Contains(Unicas[UPC Partição], [UPC Partição])),
					    Extras = Table.AddColumn(DoMapa, "Tipo", each "Sem partição", type text),
					    Final  = Table.TransformColumnTypes(Table.Combine({Unicas, Extras}),
					                 {{"UPC Partição", type text}, {"Tipo", type text}})
					in
					    Final

	table 'Medidas Carvão'
		lineageTag: 66f4872e-b3b5-4934-b435-629381ecab76

		measure 'Meta Carvão (m³)' = ```
				-- meta mensal da partição para os meses do filtro de data (dia, mês ou ano)
				VAR _meses =
				    SELECTCOLUMNS (
				        SUMMARIZE ( d_Calendario, d_Calendario[Ano], d_Calendario[Mês Número] ),
				        "@Mes", DATE ( d_Calendario[Ano], d_Calendario[Mês Número], 1 )
				    )
				VAR _meta =
				    CALCULATE ( SUM ( f_MetaCarvao[Meta m³] ), TREATAS ( _meses, f_MetaCarvao[Mês] ) )
				-- sem meta na partição: 0 quando existe carga programada ou planejamento do PCP
				-- (vazio só quando não há nada, para não criar linhas sem dados nas tabelas)
				VAR _temDados =
				    NOT ISEMPTY ( f_basePlan ) || NOT ISEMPTY ( f_PlanPCPCarvao )
				RETURN
				    IF ( ISBLANK ( _meta ), IF ( _temDados, 0 ), _meta )
				```
			formatString: #,0
			lineageTag: 02cba813-36be-4e1d-880b-63bc9c7e4588

		measure 'Carregado Carvão (m³)' = ```
				CALCULATE ( SUM ( f_basePlan[M³] ), KEEPFILTERS ( f_basePlan[CARREGADO] = "OK" ) )
				```
			formatString: #,0
			lineageTag: a346e962-cd8e-4c82-8921-e4311c4c75b7

		measure 'Dias com Carregamento' = ```
				CALCULATE ( DISTINCTCOUNT ( f_basePlan[DATA] ), KEEPFILTERS ( f_basePlan[CARREGADO] = "OK" ) )
				```
			formatString: 0
			lineageTag: 3097c727-822d-4ad4-8fc9-b8acde136936

		measure '% Atingimento Carvão' = ```
				DIVIDE ( [Carregado Carvão (m³)], [Meta Carvão (m³)], 0 )
				```
			formatString: 0.00%
			lineageTag: 4cfac09f-c59c-43a3-a189-8032bd60af8c

		measure 'Gap Carvão (m³)' = ```
				[Carregado Carvão (m³)] - [Meta Carvão (m³)]
				```
			formatString: #,0
			lineageTag: 239f52e5-92da-4057-8551-7110d50bd483

		measure 'Média Diária Carvão' = ```
				DIVIDE ( [Carregado Carvão (m³)], [Dias com Carregamento], 0 )
				```
			formatString: #,0
			lineageTag: 3a242a8e-810f-49e4-9cb9-c026558920ab

		measure 'Média Necessária Carvão' = ```
				-- quanto precisa carregar por dia, a partir de amanhã, para fechar a meta do mês (base D-1)
				VAR _base =
				    COALESCE (
				        CALCULATE ( MIN ( f_basePlan[DATA] ), KEEPFILTERS ( f_basePlan[CARREGADO] = "OK" ), ALLSELECTED ( f_basePlan[DATA] ), ALLSELECTED ( d_Calendario ) ),
				        MIN ( d_Calendario[Date] )
				    )
				VAR _fim  = EOMONTH ( _base, 0 )
				VAR _ref  = MIN ( TODAY () - 1, _fim )
				VAR _rest = DATEDIFF ( _ref, _fim, DAY )
				VAR _real = CALCULATE ( [Carregado Carvão (m³)], ALLSELECTED ( f_basePlan[DATA] ), ALLSELECTED ( d_Calendario ) )
				VAR _meta = CALCULATE ( [Meta Carvão (m³)], ALLSELECTED ( f_basePlan[DATA] ), ALLSELECTED ( d_Calendario ) )
				VAR _gap  = _meta - COALESCE ( _real, 0 )
				RETURN
				    SWITCH (
				        TRUE (),
				        ISBLANK ( _meta ), BLANK (),
				        _gap <= 0, 0,
				        _rest <= 0, BLANK (),
				        DIVIDE ( _gap, _rest )
				    )
				```
			formatString: #,0
			lineageTag: 30090a28-8862-4f34-bb48-3e5dab747cfd

		measure 'Lacuna Carvão' = ```
				-- dispersão: média realizada - média necessária. Vazia quando não há média necessária
				-- (mês já fechado ou sem meta); antes repetia a média realizada nesses casos
				VAR _nec = [Média Necessária Carvão]
				RETURN
				    IF ( NOT ISBLANK ( _nec ), [Média Diária Carvão] - _nec )
				```
			formatString: #,0
			lineageTag: 53de2a93-546a-4e53-b12c-20c1f3303c57

		measure 'Tendência Carvão (m³)' = ```
				-- projeção do mês: carregado + média diária x dias restantes (base D-1), limitada à meta.
				-- Calculada no nível do filtro atual: total na tela, por UPC/destino nas linhas da tabela.
				VAR _base =
				    COALESCE ( CALCULATE ( MIN ( f_basePlan[DATA] ), KEEPFILTERS ( f_basePlan[CARREGADO] = "OK" ) ), MIN ( d_Calendario[Date] ) )
				VAR _fim  = EOMONTH ( _base, 0 )
				VAR _ref  = MIN ( TODAY () - 1, _fim )
				VAR _real = [Carregado Carvão (m³)]
				VAR _dias = [Dias com Carregamento]
				VAR _meta = [Meta Carvão (m³)]
				VAR _rest = DATEDIFF ( _ref, _fim, DAY )
				VAR _proj = _real + DIVIDE ( _real, _dias ) * _rest
				RETURN
				    SWITCH (
				        TRUE (),
				        ISBLANK ( _meta ), BLANK (),
				        _meta <= 0, 0,
				        ISBLANK ( _real ), 0,
				        _real >= _meta, _meta,
				        _rest <= 0, _real,
				        MIN ( _proj, _meta )
				    )
				```
			formatString: #,0
			lineageTag: b0c399a4-b9a6-4b7e-8826-1bb95a0af63f

		measure '% Ritmo Carvão' = ```
