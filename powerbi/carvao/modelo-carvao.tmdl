		measure 'Furo PCP (m³)' = ```
				-- m³ planejados pelo PCP que não foram carregados no dia (planejado > realizado),
				-- somando dia a dia por UPC e destino
				VAR _dias =
				    CALCULATETABLE (
				        VALUES ( d_Calendario[Date] ),
				        TREATAS (
				            CALCULATETABLE (
				                VALUES ( f_PlanPCPCarvao[Data] ),
				                REMOVEFILTERS ( d_UPC_Carvao ),
				                REMOVEFILTERS ( d_Destino ),
				                f_PlanPCPCarvao[Data] < TODAY ()
				            ),
				            d_Calendario[Date]
				        )
				    )
				VAR _combos =
				    CROSSJOIN ( _dias, VALUES ( d_UPC_Carvao[UPC Partição] ), VALUES ( d_Destino[DESTINO] ) )
				RETURN
				    SUMX (
				        _combos,
				        VAR _p = COALESCE ( [Planejado PCP (m³)], 0 )
				        VAR _r = COALESCE ( [Carregado Carvão (m³)], 0 )
				        RETURN MAX ( _p - _r, 0 )
				    )
				```
			formatString: #,0
			lineageTag: 424d82b8-eff1-4da7-bd83-9860adfbaff0

		measure 'Furo Compensado PCP (m³)' = ```
				-- m³ carregados acima do planejado do dia (realizado > planejado), por UPC e destino:
				-- é o "furo compensado"
				VAR _dias =
				    CALCULATETABLE (
				        VALUES ( d_Calendario[Date] ),
				        TREATAS (
				            CALCULATETABLE (
				                VALUES ( f_PlanPCPCarvao[Data] ),
				                REMOVEFILTERS ( d_UPC_Carvao ),
				                REMOVEFILTERS ( d_Destino ),
				                f_PlanPCPCarvao[Data] < TODAY ()
				            ),
				            d_Calendario[Date]
				        )
				    )
				VAR _combos =
				    CROSSJOIN ( _dias, VALUES ( d_UPC_Carvao[UPC Partição] ), VALUES ( d_Destino[DESTINO] ) )
				RETURN
				    SUMX (
				        _combos,
				        VAR _p = COALESCE ( [Planejado PCP (m³)], 0 )
				        VAR _r = COALESCE ( [Carregado Carvão (m³)], 0 )
				        RETURN MAX ( _r - _p, 0 )
				    )
				```
			formatString: #,0
			lineageTag: 285d345e-c559-4a66-a6fd-8345f3242b06

